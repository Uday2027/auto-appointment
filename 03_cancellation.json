          "value": "YOUR_GOOGLE_CALENDAR_ID",
          "mode": "id"
        },
        "eventId": "={{ $('Code — Check Deadline').item.json.fields['Google Calendar Event ID'] }}"
      },
      "id": "google-calendar-delete",
      "name": "Google Calendar — Delete Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [1560, 160],
