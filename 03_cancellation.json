{
  "name": "03 — Cancellation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "cancel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cancel",
      "name": "Webhook — Cancel Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "cancel"
    },
    {
      "parameters": {
        "jsCode": "// Extract bookingId, email, and reason from query or body\nconst query = $input.item.json.query || {};\nconst body = $input.item.json.body || {};\nconst bookingId = query.bookingId || body.bookingId;\nconst email = query.email || body.email;\nconst reason = query.reason || body.reason || 'Patient requested cancellation';\n\nif (!bookingId || !email) {\n  throw new Error('Missing bookingId or email in cancellation request');\n}\n\nreturn [{ json: { bookingId, email, reason } }];"
      },
      "id": "extract-cancel-params",
      "name": "Code — Extract Cancel Params",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "list",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "filterByFormula": "=AND({Booking ID}='{{ $json.bookingId }}', {Email}='{{ $json.email }}')",
        "options": {
          "maxRecords": 1
        }
      },
      "id": "airtable-find-booking",
      "name": "Airtable — Find Booking",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [680, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable — Clinic"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Check if booking exists and is cancellable\nconst records = $input.all();\n\nif (!records || records.length === 0 || !records[0].json.fields) {\n  return [{ json: { canCancel: false, reason: 'Booking not found', record: null } }];\n}\n\nconst record = records[0].json;\nconst fields = record.fields;\n\n// Cannot cancel already cancelled bookings\nif (fields.Status === 'Cancelled' || fields.Status === 'Completed') {\n  return [{ json: { canCancel: false, reason: 'Booking is already ' + fields.Status, record, fields } }];\n}\n\n// Check 3-hour cancellation deadline\nconst appointmentDatetime = new Date(fields['Appointment Date'] + 'T' + fields['Appointment Time'] + ':00');\nconst now = new Date();\nconst hoursUntilAppt = (appointmentDatetime.getTime() - now.getTime()) / (1000 * 60 * 60);\n\nif (hoursUntilAppt < 3) {\n  return [{ \n    json: { \n      canCancel: false, \n      reason: 'Cancellation deadline passed. Appointments cannot be cancelled within 3 hours.', \n      record, \n      fields,\n      hoursUntilAppt: hoursUntilAppt.toFixed(1)\n    } \n  }];\n}\n\nreturn [{ json: { canCancel: true, reason: 'OK', record, fields, recordId: record.id } }];"
      },
      "id": "check-cancellation-deadline",
      "name": "Code — Check Deadline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.canCancel }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-can-cancel",
      "name": "IF — Can Cancel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "respondWith": "html",
        "responseBody": "=<html><body style=\"font-family:Arial;text-align:center;padding:60px;background:#fff5f5\"><h2 style=\"color:#e53e3e\">❌ Cannot Cancel</h2><p style=\"color:#555\">{{ $json.reason }}</p><p>Please call us at <strong>YOUR_CLINIC_PHONE</strong></p></body></html>",
        "options": { "responseCode": 400 }
      },
      "id": "respond-cannot-cancel",
      "name": "Respond — Cannot Cancel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 440]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "id": "={{ $json.recordId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "Cancelled",
            "Cancellation Reason": "={{ $('Code — Extract Cancel Params').item.json.reason || 'Patient requested cancellation' }}",
            "Cancelled At": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "airtable-mark-cancelled",
      "name": "Airtable — Mark Cancelled",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1340, 160],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable — Clinic"
        }
