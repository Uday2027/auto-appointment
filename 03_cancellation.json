    },
    {
      "parameters": {
        "sendTo": "={{ $('Code — Check Deadline').item.json.fields.Email }}",
        "subject": "Appointment Cancelled — YOUR_CLINIC_NAME",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px\">\n  <div style=\"background:#e53e3e;padding:20px;border-radius:10px 10px 0 0;text-align:center\">\n    <h2 style=\"color:#fff;margin:0\">Appointment Cancelled</h2>\n  </div>\n  <div style=\"background:#fff;padding:24px;border:1px solid #e2e8f0;border-radius:0 0 10px 10px\">\n    <p>Dear <strong>{{ $('Code — Check Deadline').item.json.fields['Patient Name'] }}</strong>,</p>\n    <p>Your appointment has been successfully cancelled.</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#fff5f5\"><td style=\"padding:10px;font-weight:600\">Date</td><td style=\"padding:10px\">{{ $('Code — Check Deadline').item.json.fields['Appointment Date'] }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:600\">Time</td><td style=\"padding:10px\">{{ $('Code — Check Deadline').item.json.fields['Appointment Time'] }}</td></tr>\n      <tr style=\"background:#fff5f5\"><td style=\"padding:10px;font-weight:600\">Type</td><td style=\"padding:10px\">{{ $('Code — Check Deadline').item.json.fields['Appointment Type'] }}</td></tr>\n    </table>\n    <p>To book a new appointment, visit: <a href=\"YOUR_NEXT_JS_URL\">YOUR_CLINIC_NAME Booking</a></p>\n    <p style=\"color:#888;font-size:13px\">Questions? Call YOUR_CLINIC_PHONE</p>\n  </div>\n</div>",
        "options": {}
      },
      "id": "gmail-cancellation-patient",
      "name": "Gmail — Cancellation to Patient",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1780, 100],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google — Clinic"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "YOUR_STAFF_EMAIL",
        "subject": "=❌ Appointment Cancelled — {{ $('Code — Check Deadline').item.json.fields['Patient Name'] }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif\">\n  <h3 style=\"color:#e53e3e\">Appointment Cancelled</h3>\n  <p><strong>Patient:</strong> {{ $('Code — Check Deadline').item.json.fields['Patient Name'] }}</p>\n  <p><strong>Phone:</strong> {{ $('Code — Check Deadline').item.json.fields['Phone'] }}</p>\n  <p><strong>Date:</strong> {{ $('Code — Check Deadline').item.json.fields['Appointment Date'] }}</p>\n  <p><strong>Time:</strong> {{ $('Code — Check Deadline').item.json.fields['Appointment Time'] }}</p>\n  <p><strong>Type:</strong> {{ $('Code — Check Deadline').item.json.fields['Appointment Type'] }}</p>\n  <p style=\"color:#e53e3e\">This slot is now available for another patient.</p>\n</div>",
        "options": {}
      },
      "id": "gmail-cancellation-staff",
      "name": "Gmail — Notify Staff of Cancellation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1780, 260],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google — Clinic"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "html",
        "responseBody": "<html><body style=\"font-family:Arial;text-align:center;padding:60px;background:#f0fff4\"><h2 style=\"color:#276749\">✅ Appointment Cancelled</h2><p style=\"color:#555\">Your appointment has been successfully cancelled. A confirmation email has been sent.</p><p>To book again, visit <a href=\"YOUR_NEXT_JS_URL\">our booking page</a>.</p></body></html>",
        "options": {}
      },
      "id": "respond-cancelled-ok",
