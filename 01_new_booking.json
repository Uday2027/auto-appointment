        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px\">\n  <h2 style=\"color:#2b6cb0\">New Appointment Booked</h2>\n  <table style=\"width:100%;border-collapse:collapse\">\n    <tr><td style=\"padding:8px;font-weight:600\">Patient</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.name }}</td></tr>\n    <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;font-weight:600\">Phone</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.phone }}</td></tr>\n    <tr><td style=\"padding:8px;font-weight:600\">Email</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.email }}</td></tr>\n    <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;font-weight:600\">Date</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.date }}</td></tr>\n    <tr><td style=\"padding:8px;font-weight:600\">Time</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.time }}</td></tr>\n    <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;font-weight:600\">Type</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.appointmentType }}</td></tr>\n    <tr><td style=\"padding:8px;font-weight:600\">Reason</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.reason }}</td></tr>\n    <tr style=\"background:#f5f5f5\"><td style=\"padding:8px;font-weight:600\">Age / Gender</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.age }} / {{ $('Validate & Prepare Data').item.json.gender }}</td></tr>\n    <tr><td style=\"padding:8px;font-weight:600\">Booking ID</td><td style=\"padding:8px\">{{ $('Validate & Prepare Data').item.json.bookingId }}</td></tr>\n  </table>\n  <p style=\"color:#888;font-size:12px\">This is an automated notification from YOUR_CLINIC_NAME booking system.</p>\n</div>",
        "options": {}
