          "description": "=Patient: {{ $('Validate & Prepare Data').item.json.name }}\nPhone: {{ $('Validate & Prepare Data').item.json.phone }}\nEmail: {{ $('Validate & Prepare Data').item.json.email }}\nAge: {{ $('Validate & Prepare Data').item.json.age }}\nGender: {{ $('Validate & Prepare Data').item.json.gender }}\nType: {{ $('Validate & Prepare Data').item.json.appointmentType }}\nReason: {{ $('Validate & Prepare Data').item.json.reason }}\nBooking ID: {{ $('Validate & Prepare Data').item.json.bookingId }}\nStatus: Booked",
