            "Phone": "={{ $json.phone }}",
            "Appointment Date": "={{ $json.date }}",
            "Appointment Time": "={{ $json.time }}",
            "Appointment Type": "={{ $json.appointmentType }}",
            "Reason for Visit": "={{ $json.reason }}",
            "Age": "={{ $json.age }}",
            "Gender": "={{ $json.gender }}",
            "Notes": "={{ $json.notes }}",
            "Status": "Booked",
            "Confirmation Sent": false,
            "Reminder 24h Sent": false,
            "Reminder 2h Sent": false,
            "Submitted At": "={{ $json.submittedAt }}"
          }
        },
        "options": {}
      },
      "id": "airtable-create",
