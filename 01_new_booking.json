      "parameters": {
        "sendTo": "={{ $('Validate & Prepare Data').item.json.email }}",
        "subject": "=Appointment Confirmed — Dr. YOUR_DOCTOR_NAME",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;background:#f9f9f9\">\n  <div style=\"background:#2b6cb0;padding:24px;border-radius:12px 12px 0 0;text-align:center\">\n    <h1 style=\"color:#fff;margin:0;font-size:22px\">✅ Appointment Confirmed</h1>\n  </div>\n  <div style=\"background:#fff;padding:28px;border-radius:0 0 12px 12px;border:1px solid #e2e8f0\">\n    <p style=\"font-size:16px;color:#333\">Dear <strong>{{ $('Validate & Prepare Data').item.json.name }}</strong>,</p>\n    <p style=\"color:#555\">Your appointment has been successfully booked. Please review the details below:</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:20px 0\">\n      <tr style=\"background:#ebf8ff\">\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0;width:40%\">Doctor</td>\n        <td style=\"padding:10px 14px;color:#333\">Dr. YOUR_DOCTOR_NAME</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Date</td>\n        <td style=\"padding:10px 14px;color:#333\">{{ $('Validate & Prepare Data').item.json.date }}</td>\n      </tr>\n      <tr style=\"background:#ebf8ff\">\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Time</td>\n        <td style=\"padding:10px 14px;color:#333\">{{ $('Validate & Prepare Data').item.json.time }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Type</td>\n        <td style=\"padding:10px 14px;color:#333\">{{ $('Validate & Prepare Data').item.json.appointmentType }}</td>\n      </tr>\n      <tr style=\"background:#ebf8ff\">\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Clinic</td>\n        <td style=\"padding:10px 14px;color:#333\">YOUR_CLINIC_NAME</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Address</td>\n        <td style=\"padding:10px 14px;color:#333\">YOUR_CLINIC_ADDRESS</td>\n      </tr>\n      <tr style=\"background:#ebf8ff\">\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Phone</td>\n        <td style=\"padding:10px 14px;color:#333\">YOUR_CLINIC_PHONE</td>\n      </tr>\n      <tr>\n        <td style=\"padding:10px 14px;font-weight:600;color:#2b6cb0\">Booking ID</td>\n        <td style=\"padding:10px 14px;color:#333\">{{ $('Validate & Prepare Data').item.json.bookingId }}</td>\n      </tr>\n    </table>\n    <div style=\"background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:14px;margin:20px 0\">\n      <p style=\"margin:0;color:#856404\">⚠️ Please arrive <strong>5 minutes early</strong>. Late arrival may affect your appointment slot.</p>\n    </div>\n    <p style=\"color:#555\">To manage your appointment:</p>\n    <div style=\"text-align:center;margin:20px 0\">\n      <a href=\"YOUR_N8N_BASE_URL/webhook/cancel?bookingId={{ $('Validate & Prepare Data').item.json.bookingId }}&email={{ $('Validate & Prepare Data').item.json.email }}\" style=\"background:#e53e3e;color:#fff;padding:10px 24px;border-radius:6px;text-decoration:none;margin-right:10px;display:inline-block\">Cancel Appointment</a>\n      <a href=\"YOUR_NEXT_JS_URL/reschedule?bookingId={{ $('Validate & Prepare Data').item.json.bookingId }}\" style=\"background:#2b6cb0;color:#fff;padding:10px 24px;border-radius:6px;text-decoration:none;display:inline-block\">Reschedule</a>\n    </div>\n    <hr style=\"border:none;border-top:1px solid #e2e8f0;margin:20px 0\">\n    <p style=\"color:#888;font-size:13px\">If you have questions, call us at <strong>YOUR_CLINIC_PHONE</strong></p>\n  </div>\n</div>",
        "options": {}
      },
