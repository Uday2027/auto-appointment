    {
      "parameters": {
        "jsCode": "// Check if appointment is within the 24-hour window (22h to 25h from now)\nconst items = $input.all();\nconst now = new Date().getTime();\nconst WINDOW_MIN = 22 * 60 * 60 * 1000; // 22 hours\nconst WINDOW_MAX = 25 * 60 * 60 * 1000; // 25 hours\n\nconst ready = items.filter(item => {\n  const f = item.json.fields;\n  if (!f || !f['Appointment Date'] || !f['Appointment Time']) return false;\n  const apptDatetime = new Date(f['Appointment Date'] + 'T' + f['Appointment Time'] + ':00').getTime();\n  const diff = apptDatetime - now;\n  return diff >= WINDOW_MIN && diff <= WINDOW_MAX;\n});\n\nif (ready.length === 0) {\n  return [{ json: { skip: true, count: 0 } }];\n}\n\nreturn ready.map(item => ({ json: { ...item.json, _readyFor24h: true } }));"
      },
      "id": "check-24h-window",
      "name": "Code — Check 24h Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "jsCode": "// Check if appointment is within 2-hour window (1h45m to 2h15m from now)\nconst items = $input.all();\nconst now = new Date().getTime();\nconst WINDOW_MIN = 1.75 * 60 * 60 * 1000; // 1h 45min\nconst WINDOW_MAX = 2.25 * 60 * 60 * 1000; // 2h 15min\n\nconst ready = items.filter(item => {\n  const f = item.json.fields;\n  if (!f || !f['Appointment Date'] || !f['Appointment Time']) return false;\n  const apptDatetime = new Date(f['Appointment Date'] + 'T' + f['Appointment Time'] + ':00').getTime();\n  const diff = apptDatetime - now;\n  return diff >= WINDOW_MIN && diff <= WINDOW_MAX;\n});\n\nif (ready.length === 0) {\n  return [{ json: { skip: true, count: 0 } }];\n}\n\nreturn ready.map(item => ({ json: { ...item.json, _readyFor2h: true } }));"
      },
      "id": "check-2h-window",
      "name": "Code — Check 2h Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "if-24h-ready",
      "name": "IF — 24h Appointments Ready",
      "type": "n8n-nodes-base.if",
