    {
      "parameters": {
        "sendTo": "={{ $json.fields.Email }}",
        "subject": "=⏰ Reminder: Your Appointment Tomorrow — Dr. YOUR_DOCTOR_NAME",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px\">\n  <div style=\"background:#2b6cb0;padding:20px;border-radius:10px 10px 0 0;text-align:center\">\n    <h2 style=\"color:#fff;margin:0\">⏰ Appointment Reminder</h2>\n    <p style=\"color:#bee3f8;margin:6px 0 0\">Your appointment is tomorrow</p>\n  </div>\n  <div style=\"background:#fff;padding:24px;border:1px solid #e2e8f0;border-radius:0 0 10px 10px\">\n    <p>Dear <strong>{{ $json.fields['Patient Name'] }}</strong>,</p>\n    <p>This is a friendly reminder about your appointment tomorrow:</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#ebf8ff\"><td style=\"padding:10px;font-weight:600\">Doctor</td><td style=\"padding:10px\">Dr. YOUR_DOCTOR_NAME</td></tr>\n      <tr><td style=\"padding:10px;font-weight:600\">Date</td><td style=\"padding:10px\">{{ $json.fields['Appointment Date'] }}</td></tr>\n      <tr style=\"background:#ebf8ff\"><td style=\"padding:10px;font-weight:600\">Time</td><td style=\"padding:10px\">{{ $json.fields['Appointment Time'] }}</td></tr>\n      <tr><td style=\"padding:10px;font-weight:600\">Type</td><td style=\"padding:10px\">{{ $json.fields['Appointment Type'] }}</td></tr>\n      <tr style=\"background:#ebf8ff\"><td style=\"padding:10px;font-weight:600\">Location</td><td style=\"padding:10px\">YOUR_CLINIC_ADDRESS</td></tr>\n      <tr><td style=\"padding:10px;font-weight:600\">Contact</td><td style=\"padding:10px\">YOUR_CLINIC_PHONE</td></tr>\n    </table>\n    <div style=\"background:#f0fff4;border:1px solid #9ae6b4;border-radius:8px;padding:12px;margin:16px 0\">\n      <p style=\"margin:0;color:#276749\">✅ Please arrive 5 minutes early and bring any relevant medical reports.</p>\n    </div>\n    <div style=\"text-align:center;margin:20px 0\">\n      <a href=\"YOUR_N8N_BASE_URL/webhook/cancel?bookingId={{ $json.fields['Booking ID'] }}&email={{ $json.fields['Email'] }}\" style=\"background:#e53e3e;color:#fff;padding:10px 20px;border-radius:6px;text-decoration:none;display:inline-block\">Cancel Appointment</a>\n    </div>\n    <p style=\"color:#888;font-size:12px\">Need to reschedule? Call us at YOUR_CLINIC_PHONE</p>\n  </div>\n</div>",
        "options": {}
      },
