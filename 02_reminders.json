      "id": "airtable-get-pending-2h",
      "name": "Airtable — Get Pending 2h Reminders",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 420],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable — Clinic"
        }
      }
