          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Appointments",
          "mode": "name"
        },
        "filterByFormula": "=AND(OR({Status}='Booked',{Status}='Confirmed'), {Reminder 24h Sent}=TRUE(), {Reminder 2h Sent}=FALSE(), {Appointment Date}>=TODAY())",
        "options": {
          "fields": ["Booking ID","Patient Name","Email","Phone","Appointment Date","Appointment Time","Appointment Type","Status","Reminder 24h Sent","Reminder 2h Sent"]
