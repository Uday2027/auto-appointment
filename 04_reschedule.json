    {
      "parameters": {
        "jsCode": "// Validate reschedule payload from query or body\nconst query = $input.item.json.query || {};\nconst body = $input.item.json.body || {};\nconst bookingId = query.bookingId || body.bookingId;\nconst email = query.email || body.email;\nconst newDate = query.newDate || body.newDate;\nconst newTime = query.newTime || body.newTime;\nconst reason = query.reason || body.reason || 'No reason provided';\n\nif (!bookingId || !email || !newDate || !newTime) {\n  throw new Error('Missing required fields: bookingId, email, newDate, newTime');\n}\n\n// Validate new date is not in the past\nconst parsedNewDate = new Date(newDate);\nconst today = new Date();\ntoday.setHours(0,0,0,0);\nif (parsedNewDate < today) {\n  throw new Error('New appointment date cannot be in the past');\n}\n\n// Build new datetime strings\nconst newStartDatetime = newDate + 'T' + newTime + ':00';\nconst newEndMs = new Date(newStartDatetime).getTime() + (20 * 60 * 1000);\nconst newEndDatetime = new Date(newEndMs).toISOString();\n\nreturn [{\n  json: {\n    bookingId,\n    email,\n    newDate,\n    newTime,\n    newStartDatetime,\n    newEndDatetime,\n    reason\n  }\n}];"
      },
      "id": "validate-reschedule",
      "name": "Code \u2014 Validate Reschedule",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "list",
        "base": {
          "__rl": true,
          "value": "app2JpHihx47EnGFj",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "tblwoViU7bTwcDG3f",
          "mode": "name"
        },
        "filterByFormula": "=AND({Booking ID}='{{ $json.bookingId }}', {Email}='{{ $json.email }}')",
        "options": {
          "maxRecords": 1
        }
      },
      "id": "airtable-find-for-reschedule",
      "name": "Airtable \u2014 Find Booking",
      "type": "n8n-nodes-base.airtable",
