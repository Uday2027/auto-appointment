        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px\">\n  <div style=\"background:#2b6cb0;padding:20px;border-radius:10px 10px 0 0;text-align:center\">\n    <h2 style=\"color:#fff;margin:0\">\ud83d\udd04 Appointment Rescheduled</h2>\n  </div>\n  <div style=\"background:#fff;padding:24px;border:1px solid #e2e8f0;border-radius:0 0 10px 10px\">\n    <p>Dear <strong>{{ $('Code \u2014 Check Reschedulable').item.json.fields['Patient Name'] }}</strong>,</p>\n    <p>Your appointment has been successfully rescheduled.</p>\n    <table style=\"width:100%;border-collapse:collapse;margin:16px 0\">\n      <tr style=\"background:#f5f5f5\"><td colspan=\"2\" style=\"padding:10px;font-weight:700;color:#666\">Previous Appointment</td></tr>\n      <tr><td style=\"padding:8px 10px;color:#888\">Date</td><td style=\"padding:8px 10px;color:#888;text-decoration:line-through\">{{ $('Code \u2014 Check Reschedulable').item.json.oldDate }}</td></tr>\n      <tr><td style=\"padding:8px 10px;color:#888\">Time</td><td style=\"padding:8px 10px;color:#888;text-decoration:line-through\">{{ $('Code \u2014 Check Reschedulable').item.json.oldTime }}</td></tr>\n      <tr style=\"background:#ebf8ff\"><td colspan=\"2\" style=\"padding:10px;font-weight:700;color:#2b6cb0\">New Appointment</td></tr>\n      <tr><td style=\"padding:8px 10px;font-weight:600\">Date</td><td style=\"padding:8px 10px\">{{ $('Code \u2014 Check Reschedulable').item.json.newDate }}</td></tr>\n      <tr><td style=\"padding:8px 10px;font-weight:600\">Time</td><td style=\"padding:8px 10px\">{{ $('Code \u2014 Check Reschedulable').item.json.newTime }}</td></tr>\n      <tr><td style=\"padding:8px 10px;font-weight:600\">Doctor</td><td style=\"padding:8px 10px\">Dr. YOUR_DOCTOR_NAME</td></tr>\n      <tr><td style=\"padding:8px 10px;font-weight:600\">Location</td><td style=\"padding:8px 10px\">YOUR_CLINIC_ADDRESS</td></tr>\n    </table>\n    <p style=\"color:#888;font-size:13px\">Questions? Call YOUR_CLINIC_PHONE</p>\n  </div>\n</div>",
