    {
      "parameters": {
        "jsCode": "// Check the booking exists and is reschedulable\nconst records = $input.all();\nconst rescheduleData = $('Code \u2014 Validate Reschedule').item.json;\n\nif (!records || records.length === 0 || !records[0].json.fields) {\n  throw new Error('Booking not found: ' + rescheduleData.bookingId);\n}\n\nconst record = records[0].json;\nconst fields = record.fields;\n\nif (fields.Status === 'Cancelled' || fields.Status === 'Completed') {\n  throw new Error('Cannot reschedule a ' + fields.Status + ' appointment');\n}\n\n// Check 3 hour deadline\nconst currentApptDatetime = new Date(fields['Appointment Date'] + 'T' + fields['Appointment Time'] + ':00');\nconst hoursUntil = (currentApptDatetime.getTime() - Date.now()) / (1000 * 60 * 60);\n\nif (hoursUntil < 3) {\n  throw new Error('Cannot reschedule within 3 hours of appointment');\n}\n\nreturn [{\n  json: {\n    ...rescheduleData,\n    recordId: record.id,\n    fields,\n    calendarEventId: fields['Google Calendar Event ID'],\n    oldDate: fields['Appointment Date'],\n    oldTime: fields['Appointment Time']\n  }\n}];"
      },
      "id": "check-reschedulable",
      "name": "Code \u2014 Check Reschedulable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
